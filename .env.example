# =============================================================================
# MuniAI configuration — copy to /etc/muniai/muniai.env in production,
# or to backend/.env for local development. NEVER commit real secrets.
# =============================================================================

# --- Core ---------------------------------------------------------------------
MUNIAI_ENV=development                 # development | production
MUNIAI_SECRET_KEY=change-me-to-a-long-random-string
MUNIAI_BASE_URL=http://localhost:5173  # public URL of the app (for links)
MUNIAI_LOG_LEVEL=INFO

# --- API ----------------------------------------------------------------------
MUNIAI_API_HOST=127.0.0.1              # bind localhost; Nginx sits in front
MUNIAI_API_PORT=8000
# Comma-separated origins allowed by CORS (dev frontend, prod domain)
MUNIAI_CORS_ORIGINS=http://localhost:5173

# --- Auth ---------------------------------------------------------------------
MUNIAI_JWT_ALGORITHM=HS256
MUNIAI_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Bootstrap local administrator (created on first startup if no users exist)
MUNIAI_BOOTSTRAP_ADMIN_EMAIL=admin@muniai.local
MUNIAI_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
MUNIAI_BOOTSTRAP_ADMIN_NAME=System Administrator

# --- Database (PostgreSQL + pgvector) ----------------------------------------
# pgvector is required for embeddings/RAG. Postgres 14+ recommended.
MUNIAI_DATABASE_URL=postgresql+psycopg://muniai:muniai@localhost:5432/muniai

# --- Redis / background jobs --------------------------------------------------
MUNIAI_REDIS_URL=redis://localhost:6379/0

# --- AI providers (LOCAL-FIRST) ----------------------------------------------
# The default provider is Ollama running locally. NO cloud AI keys are required
# and none are configured here. External AI escalation is manual (see spec §7).
MUNIAI_AI_PROVIDER=ollama
MUNIAI_OLLAMA_BASE_URL=http://localhost:11434
MUNIAI_OLLAMA_CHAT_MODEL=llama3.1:8b
MUNIAI_OLLAMA_EMBED_MODEL=nomic-embed-text
MUNIAI_OLLAMA_TIMEOUT_SECONDS=120

# --- Localization -------------------------------------------------------------
MUNIAI_DEFAULT_LANGUAGE=he            # he | ar | en
MUNIAI_DEFAULT_TIMEZONE=Asia/Jerusalem

# --- Storage ------------------------------------------------------------------
MUNIAI_DATA_DIR=/opt/muniai/data      # local FS root for documents/uploads
MUNIAI_MAX_UPLOAD_MB=200

# --- Branding (per-municipality; not hard-coded in product) ------------------
MUNIAI_ORG_NAME=MuniAI
MUNIAI_ORG_ACCENT_COLOR=#0F6CBD
